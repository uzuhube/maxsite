{
  "manifest_version": 3,
  "name": "GeoGuessr Solver",
  "version": "1.0.0",
  "description": "Auto location recognition for GeoGuessr",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["*://*.geoguessr.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.geoguessr.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
