{
  "manifest_version": 2,
  "name": "GeoGuessr Solver",
  "version": "1.0.0",
  "description": "Auto location recognition for GeoGuessr",
  "browser_specific_settings": {
    "gecko": {
      "id": "geoguessr-solver@solver.local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "activeTab",
    "*://*.geoguessr.com/*"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.geoguessr.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
